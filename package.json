{
  "name": "@salzpate/react-ui",
  "description": "React UI component library built with Tailwind CSS",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/react-ui.js",
  "version": "1.5.9",
  "license": "Apache-2.0",
  "author": "Ronny Krammer",
  "repository": {
    "type": "git",
    "url": "https://github.com/salzpate/react-ui.git"
  },
  "module": "dist/react-ui.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-ui.js"
    },
    "./styles": {
      "default": "./dist/style.css"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && vite build && npx @tailwindcss/cli -i ./styles/globals.css -o ./dist/style.css --minify",
    "build:storybook": "storybook build",
    "dev": "storybook dev -p 6006",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src && tsc --noEmit && prettier --check .",
    "lint:style": "stylelint '**/*.css' --fix",
    "lint:style:check": "stylelint '**/*.css'",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --run --coverage"
  },
  "husky": {
    "hooks": {
      "pre-commit": "eslint src && tsc --noEmit && prettier --check ."
    }
  },
  "peerDependencies": {
    "next": "^16.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/nextjs": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "next": "^16.4.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "optionalDependencies": {
    "@parcel/watcher-linux-x64-glibc": "^2.6.0",
    "@rollup/rollup-linux-x64-gnu": "^4.64.0"
  }
}
